generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int         @id @default(autoincrement())
  name           String
  email          String      @unique
  password       String
  phone          String?
  role           String      @default("CLIENT")
  createdAt      DateTime    @default(now())
  comments       Comment[]
  equipment      Equipment[]
  clientRequests Request[]   @relation("ClientRequests")
  masterRequests Request[]   @relation("MasterRequests")
}

model Equipment {
  id           Int       @id @default(autoincrement())
  name         String
  serialNumber String    @unique
  purchaseDate DateTime?
  status       String    @default("исправна")
  clientId     Int
  createdAt    DateTime  @default(now())
  client       User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requests     Request[]
}

model Request {
  id            Int        @id @default(autoincrement())
  description   String
  /// Медицинская услуга/направление (для записи)
  serviceName   String?
  /// Желаемая дата и время визита
  preferredAt   DateTime?
  /// Жалобы/симптомы (кратко)
  symptoms      String?
  equipmentType String? // legacy (старое поле из темы "ремонт техники")
  status        String     @default("новая")
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  // <- убедись, что есть эти поля
  clientName    String
  clientPhone   String
  clientEmail   String?
  serviceId     String?

  clientId      Int?
  client        User?       @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)

  masterId      Int?
  master        User?      @relation("MasterRequests", fields: [masterId], references: [id], onDelete: SetNull)

  equipmentId   Int?
  equipment     Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  comments      Comment[]
  price         String
}


model Comment {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
  requestId Int
  authorId  Int
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
